DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DATABASE_URL=
MESSAGE_CONTENT_INTENT_ENABLED=true

# ── AI ────────────────────────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# Optional: override the model used by the AI Assistant (/ai, %ai).
# Defaults to llama-3.3-70b-versatile on Groq, or the provider's default model otherwise.
AI_ASSISTANT_MODEL=

# ── Bot config ────────────────────────────────────────────────────────────────
BOT_OWNERS=
PORT=3000

# ── Top.gg votes ──────────────────────────────────────────────────────────────
# The authorization secret set in your Top.gg webhook dashboard.
# Top.gg will send this in the Authorization header on every webhook call.
TOPGG_WEBHOOK_SECRET=
# API token from top.gg/api/docs — used by /vote check to verify votes live.
TOPGG_TOKEN=
# Channel ID where every incoming vote is logged (bot-wide, any server the bot can see).
VOTE_LOG_CHANNEL_ID=

# ── Emoji server ──────────────────────────────────────────────────────────────
# ID of the server you use as an emoji server.
# Add your animated/custom emojis there and the bot will load and use them.
EMOJI_SERVER_ID=
